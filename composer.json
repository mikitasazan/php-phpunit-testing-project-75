{
    "name": "hexlet/code",
    "description": "Скачивает страницу вместе с её ресурсами и сохраняет её на диск",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "bin": [
        "bin/page-loader"
    ],
    "require": {
        "php": ">=8.1",
        "docopt/docopt": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/collections": "*",
        "monolog/monolog": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "spatie/temporary-directory": "^1.3",
        "squizlabs/php_codesniffer": "^3.5",
        "mikehaertl/php-shellcommand": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Project\\tests\\": "tests/"
        },
        "files": [
            "src/Utils.php",
            "src/Downloader.php",
            "tests/Utils.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
